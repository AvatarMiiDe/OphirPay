# ═══════════════════════════════════════════════════════════════
# OphirPay — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For production, set these in your deployment platform
# (Vercel, Kubernetes secrets, Docker env, etc.)

# ── Database (Required) ────────────────────────────────────────
# PostgreSQL connection string. SQLite supported for local dev only.
DATABASE_URL=postgresql://localhost:5432/ophirpay
DATABASE_PROVIDER=postgresql

# Connection pooling direct URL (Supabase, Neon, PgBouncer).
# Required for Prisma migrate when using pooled DATABASE_URL.
# DIRECT_DATABASE_URL=postgresql://...

# ── Stellar Network (Required) ─────────────────────────────────
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org:443
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Smart Contracts (Required) ─────────────────────────────────
# Deploy contracts via ./scripts/deploy-all.sh and paste IDs here.
NEXT_PUBLIC_CONTRACT_ID=
NEXT_PUBLIC_EMITTER_CONTRACT_ID=

# ── App Configuration ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Rate Limiting (Optional) ───────────────────────────────────
RATE_LIMIT_RPM=120

# Redis URL for distributed rate limiting (optional).
# If not set, in-memory rate limiting is used (single instance only).
# REDIS_URL=redis://localhost:6379

# ── Monitoring (Optional) ──────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_GA_ID=

# ── Chain Read Source (Optional) ───────────────────────────────
# NEXT_PUBLIC_CHAIN_READ_SOURCE=

# ── Feature Flags (Optional) ───────────────────────────────────
# NEXT_PUBLIC_DEMO_MODE=true
# NEXT_PUBLIC_FEATURE_MULTI_ASSET=true
# NEXT_PUBLIC_FEATURE_WEBHOOKS=true

# ── Version (Optional) ─────────────────────────────────────────
# NEXT_PUBLIC_APP_VERSION=0.1.0

# ── OphirPay Environment Variables ──────────────────────────
# Copy this file to .env and fill in the values.
# All NEXT_PUBLIC_* variables are exposed to the browser.

# ── Database ────────────────────────────────────────────────
# SQLite (development) — no setup required
DATABASE_URL="file:./dev.db"

# PostgreSQL (production) — uncomment and set:
# DATABASE_URL="postgresql://user:password@host:5432/ophirpay"
# DIRECT_DATABASE_URL="postgresql://user:password@host:5432/ophirpay"

# ── Stellar Network ─────────────────────────────────────────
# Swap TESTNET → PUBLIC for mainnet deployment
NEXT_PUBLIC_STELLAR_NETWORK="TESTNET"
NEXT_PUBLIC_STELLAR_RPC_URL="https://soroban-testnet.stellar.org:443"
NEXT_PUBLIC_STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Mainnet values for reference:
# NEXT_PUBLIC_STELLAR_NETWORK="PUBLIC"
# NEXT_PUBLIC_STELLAR_RPC_URL="https://soroban-mainnet.stellar.org:443"
# NEXT_PUBLIC_STELLAR_HORIZON_URL="https://horizon.stellar.org"
# STELLAR_NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"

# ── Soroban Smart Contracts ─────────────────────────────────
# Deployed on Stellar Testnet
NEXT_PUBLIC_CONTRACT_ID="CBRCZHMNWOFTWOTCI2WBQ5A5HVKVLO2AXHYIWJ5FVYB45OHLSLWGJGYB"
NEXT_PUBLIC_EMITTER_CONTRACT_ID="CA6LAPR4OWABPWORBQGK5O5H5S62GIPQBKP3PH7H2DQ3ZNSWSH3RHFE4"

# Source account for read-only chain simulation (public testnet account)
NEXT_PUBLIC_CHAIN_READ_SOURCE="GACZ7ZELCUC5YGJ6JHIVLEZNR3XKYKOVUWD6H3IRFPRZMALNUYJZQM2U"

# ── Application ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_VERSION="0.1.0"
NODE_ENV="development"

# ── Optional: Analytics & Monitoring ────────────────────────
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
# NEXT_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"

# ── Optional: Feature Flags ─────────────────────────────────
# Set to "true" to enable (default: disabled)
# NEXT_PUBLIC_FEATURE_MULTI_ASSET="false"
# NEXT_PUBLIC_FEATURE_WEBHOOKS="false"

# ── Rate Limiting ───────────────────────────────────────────
# Requests per minute per IP (default: 120)
# RATE_LIMIT_RPM="120"

#     --source-account <SECRET_KEY> --network testnet \
#     -- init --owner GAB2BCF2X3KFYHGBNE5N6ZGQ534SQXLKSYE6KIFY2SDOJPGLT446WUUK
#
# To link Emitter:
#   stellar contract invoke --id CC2XLIFNV3UMCC3OVIG3TPRUV2VBOYYVFSUAMKQZQLKVN5MFNQECGRZ5 \
#     --source-account <SECRET_KEY> --network testnet \
#     -- set_emitter --caller GAB2BCF2X3KFYHGBNE5N6ZGQ534SQXLKSYE6KIFY2SDOJPGLT446WUUK \
#     --emitter CCWY4XCRX3WDOMEM7INVMAIAMGUNFFM2F7BCYFON6J65IIHEOQOHL4XU

